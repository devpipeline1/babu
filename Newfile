Thanos IAM policy:
==================

cat > thanos-s3-policy.json <<EOF
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ThanosBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::${THANOS_BUCKET}"
    },
    {
      "Sid": "ThanosObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::${THANOS_BUCKET}/*"
    }
  ]
}
EOF

aws iam create-policy \
  --policy-name ThanosS3AccessPolicy \
  --policy-document file://thanos-s3-policy.json

