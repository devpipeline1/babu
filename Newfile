vi monitoring-eks.yaml

apiVersion: eksctl.io/v1alpha5
kind: ClusterConfig

metadata:
  name: monitoring-eks
  region: ap-south-1
  version: "1.36"

iam:
  withOIDC: true

vpc:
  id: $MON_VPC_ID

  subnets:
    private:
      monitoring-private-a:
        id: $MON_PRIVATE_1_ID

      monitoring-private-b:
        id: $MON_PRIVATE_2_ID

managedNodeGroups:
  - name: monitoring-workers
    instanceType: t3.xlarge
    minSize: 2
    desiredCapacity: 2
    maxSize: 3

    privateNetworking: true
    volumeSize: 50
    volumeType: gp3
    labels:
      workload: monitoring

    tags:
      Name: monitoring-eks-worker
      Environment: demo
      Cluster: monitoring-eks
      Workload: monitoring

addons:
  - name: vpc-cni
  - name: coredns
  - name: kube-proxy
  - name: aws-ebs-csi-driver
  - name: metrics-server

