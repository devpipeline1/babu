Add Grafana Helm repository:
===========================
helm repo add grafana https://grafana.github.io/helm-charts
helm repo update

kubectl create namespace alloy

vi alloy-values.yaml

alloy:

  configMap:

    content: |

      // =====================================================
      // LOGGING
      // =====================================================

      logging {
        level  = "info"
        format = "logfmt"
      }


      // =====================================================
      // REMOTE WRITE TO MIMIR
      // =====================================================

      prometheus.remote_write "mimir" {

        endpoint {

          url = "http://a1a59c4d9dc284219ba4fd9ffd58cd12-1296e3666176ea98.elb.ap-south-1.amazonaws.com/api/v1/push"

        }

      }


      // =====================================================
      // DISCOVER KUBERNETES NODES
      // =====================================================

      discovery.kubernetes "nodes" {

        role = "node"

      }


      // =====================================================
      // KUBELET METRICS
      //
      // Collect:
      //
      // kubelet runtime metrics
      // node capacity
      // pod information
      // =====================================================

      discovery.relabel "kubelet" {

        targets = discovery.kubernetes.nodes.targets


        // -------------------------------------------------
        // USE NODE INTERNAL IP + KUBELET PORT
        // -------------------------------------------------

        rule {

          source_labels = [
            "__meta_kubernetes_node_address_InternalIP",
          ]

          regex = "(.+)"

          target_label = "__address__"

          replacement = "$1:10250"

        }


        // -------------------------------------------------
        // KUBELET METRICS PATH
        // -------------------------------------------------

        rule {

          target_label = "__metrics_path__"

          replacement = "/metrics"

        }


        // -------------------------------------------------
        // CLUSTER LABEL
        // -------------------------------------------------

        rule {

          target_label = "cluster"

          replacement = "application-eks"

        }


        // -------------------------------------------------
        // NODE LABEL
        // -------------------------------------------------

        rule {

          source_labels = [
            "__meta_kubernetes_node_name",
          ]

          target_label = "node"

        }

      }


      prometheus.scrape "kubelet" {

        targets = discovery.relabel.kubelet.output


        forward_to = [
          prometheus.remote_write.mimir.receiver,
        ]


        scheme = "https"


        scrape_interval = "30s"


        scrape_timeout = "10s"


        bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"


        tls_config {

          insecure_skip_verify = true

        }

      }


      // =====================================================
      // CADVISOR CONTAINER METRICS
      //
      // Collect:
      //
      // container_cpu_usage_seconds_total
      // container_memory_working_set_bytes
      // container_network_receive_bytes_total
      // container_network_transmit_bytes_total
      //
      // =====================================================

      discovery.relabel "cadvisor" {

        targets = discovery.kubernetes.nodes.targets


        // -------------------------------------------------
        // USE NODE INTERNAL IP + KUBELET PORT
        // -------------------------------------------------

        rule {

          source_labels = [
            "__meta_kubernetes_node_address_InternalIP",
          ]

          regex = "(.+)"

          target_label = "__address__"

          replacement = "$1:10250"

        }


        // -------------------------------------------------
        // CADVISOR METRICS PATH
        // -------------------------------------------------

        rule {

          target_label = "__metrics_path__"

          replacement = "/metrics/cadvisor"

        }


        // -------------------------------------------------
        // CLUSTER LABEL
        // -------------------------------------------------

        rule {

          target_label = "cluster"

          replacement = "application-eks"

        }


        // -------------------------------------------------
        // NODE LABEL
        // -------------------------------------------------

        rule {

          source_labels = [
            "__meta_kubernetes_node_name",
          ]

          target_label = "node"

        }

      }


      prometheus.scrape "cadvisor" {

        targets = discovery.relabel.cadvisor.output


        forward_to = [
          prometheus.remote_write.mimir.receiver,
        ]


        scheme = "https"


        scrape_interval = "30s"


        scrape_timeout = "10s"


        bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"


        tls_config {

          insecure_skip_verify = true

        }

      }

controller:
  type: deployment
  replicas: 1
rbac:
  create: true
serviceAccount:
  create: true
  automountServiceAccountToken: true


